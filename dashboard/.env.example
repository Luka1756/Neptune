# Copy this file to .env.local and adjust. Never commit real environment files.
#
# Everything prefixed VITE_ is bundled into the page and visible to every
# visitor. Only put PUBLIC values here. Never put a Discord client secret, a
# bot token or any other secret in this file.

# Base URL of the Neptune backend API, without a trailing slash.
# The backend is not connected yet, so leave this empty for now.
# Example for later: https://api.example.com
VITE_API_BASE_URL=
